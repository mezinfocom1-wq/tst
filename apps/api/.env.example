# Base de données
DATABASE_URL="postgresql://salon:salon@localhost:5432/salon?schema=public"

# Serveur
PORT=4000
WEB_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"

# Jetons (générer des valeurs longues et aléatoires en production)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# Compte Super Admin créé par le seed
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="ChangeMe!12345"

# Google OAuth (laisser vide pour désactiver)
GOOGLE_CLIENT_ID=""

# Email SMTP (laisser vide : les emails sont journalisés au lieu d'être envoyés)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Salon <no-reply@example.com>"

# Stockage : "local" (dossier uploads/) ou "s3"
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Push : jeton d'accès Expo (facultatif)
EXPO_ACCESS_TOKEN=""
