# Variables du fichier docker-compose.yml. Copier vers .env à la racine et renseigner.
# Générer un secret : openssl rand -base64 48

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# Adresse publique du site (avec https en production) et cookies sécurisés.
WEB_URL=http://localhost:3000
COOKIE_SECURE=false
WEB_PORT=3000

# Facultatif : connexion Google, email, stockage S3, notifications push.
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Salonat <no-reply@example.com>"
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
EXPO_ACCESS_TOKEN=
