generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Comptes ─────────────

enum Role {
  SUPER_ADMIN
  PROFESSIONAL
  CLIENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String?
  googleId        String?       @unique
  role            Role          @default(CLIENT)
  status          AccountStatus @default(ACTIVE)
  firstName       String
  lastName        String
  phone           String?
  locale          String        @default("fr")
  emailVerifiedAt DateTime?
  failedLogins    Int           @default(0)
  lockedUntil     DateTime?
  notifPrefs      Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  refreshTokens  RefreshToken[]
  emailTokens    EmailToken[]
  devices        DeviceToken[]
  notifications  Notification[]
  proApplication ProApplication?
  salons         Salon[]
  staffProfiles  StaffMember[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ApplicationStatus {
  PENDING
  INFO_REQUESTED
  APPROVED
  REJECTED
}

model ProApplication {
  id           String            @id @default(uuid())
  userId       String            @unique
  status       ApplicationStatus @default(PENDING)
  businessName String
  city         String
  phone        String
  profession   String
  message      String?
  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Salon (locataire) ─────────────

enum SalonStatus {
  DRAFT
  PENDING_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum SalonType {
  MEN
  WOMEN
  MIXED
  KIDS
}

model Salon {
  id               String      @id @default(uuid())
  ownerId          String
  slug             String      @unique
  name             String
  description      String      @default("")
  type             SalonType   @default(MEN)
  phone            String?
  email            String?
  address          String      @default("")
  city             String      @default("")
  district         String?
  latitude         Float?
  longitude        Float?
  logoUrl          String?
  coverUrl         String?
  brandColor       String?
  status           SalonStatus @default(DRAFT)
  reviewNote       String?
  bookingEnabled   Boolean     @default(true)
  queueEnabled     Boolean     @default(true)
  queueOnsiteOnly  Boolean     @default(false)
  qrToken          String      @unique
  lateToleranceMin Int         @default(10)
  cancelMinHours   Int         @default(2)
  bookingLeadMin   Int         @default(60)
  allowRequeue     Boolean     @default(true)
  slotStepMin      Int         @default(15)
  ratingAvg        Float       @default(0)
  ratingCount      Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  owner         User             @relation(fields: [ownerId], references: [id])
  photos        SalonPhoto[]
  staff         StaffMember[]
  services      Service[]
  appointments  Appointment[]
  tickets       QueueTicket[]
  subscriptions Subscription[]
  reviews       Review[]
  loyalty       LoyaltyProgram?
  rewards       LoyaltyReward[]

  @@index([city, status])
  @@index([ownerId])
}

model SalonPhoto {
  id       String @id @default(uuid())
  salonId  String
  url      String
  position Int    @default(0)
  salon    Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model StaffMember {
  id          String   @id @default(uuid())
  salonId     String
  userId      String?
  displayName String
  title       String?
  photoUrl    String?
  isOwner     Boolean  @default(false)
  active      Boolean  @default(true)
  /// Invitation à se connecter envoyée par le propriétaire (jeton stocké haché, à usage unique).
  inviteEmail     String?
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  createdAt   DateTime @default(now())

  salon        Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
  services     StaffService[]
  workingHours WorkingHour[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  tickets      QueueTicket[]

  @@index([salonId])
}

model Service {
  id          String   @id @default(uuid())
  salonId     String
  name        String
  description String?
  category    String   @default("Coupe")
  durationMin Int
  priceMad    Int
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  salon        Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  appointments Appointment[]
  tickets      QueueTicket[]

  @@index([salonId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

/// Plage de travail hebdomadaire, en minutes depuis minuit (heure du Maroc).
/// Plusieurs plages par jour : l'intervalle entre deux plages est une pause.
model WorkingHour {
  id       String      @id @default(uuid())
  salonId  String
  staffId  String
  weekday  Int
  startMin Int
  endMin   Int
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

/// Absence, congé ou indisponibilité temporaire.
model TimeOff {
  id      String      @id @default(uuid())
  salonId String
  staffId String
  startAt DateTime
  endAt   DateTime
  reason  String?
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startAt])
}

// ───────────── Réservations ─────────────

model Booking {
  id               String   @id @default(uuid())
  salonId          String
  clientId         String?
  guestName        String?
  guestPhone       String?
  createdById      String
  isGroup          Boolean  @default(false)
  totalPriceMad    Int
  totalDurationMin Int
  note             String?
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())

  appointments Appointment[]

  @@index([salonId])
  @@index([clientId])
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(uuid())
  salonId        String
  bookingId      String
  staffId        String
  serviceId      String
  clientId       String?
  personName     String?
  startAt        DateTime
  endAt          DateTime
  priceMad       Int
  status         AppointmentStatus @default(CONFIRMED)
  startedAt      DateTime?
  finishedAt     DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  salon   Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  booking Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   StaffMember @relation(fields: [staffId], references: [id])
  service Service     @relation(fields: [serviceId], references: [id])
  review  Review?

  @@index([salonId, startAt])
  @@index([staffId, startAt])
  @@index([clientId])
}

// ───────────── File d'attente ─────────────

enum TicketStatus {
  WAITING
  CALLED
  IN_SERVICE
  DONE
  CANCELLED
  NO_SHOW
}

model QueueTicket {
  id           String       @id @default(uuid())
  salonId      String
  day          String
  number       Int
  clientId     String?
  guestName    String?
  serviceId    String
  staffId      String?
  anyStaff     Boolean      @default(false)
  status       TicketStatus @default(WAITING)
  priceMad     Int
  notifiedNear Boolean      @default(false)
  joinedAt     DateTime     @default(now())
  calledAt     DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?

  salon   Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id])
  staff   StaffMember? @relation(fields: [staffId], references: [id])
  review  Review?

  @@unique([salonId, day, number])
  @@index([salonId, day, status])
  @@index([clientId])
}

/// Historique des changements de statut (rendez-vous et tickets).
model StatusEvent {
  id         String   @id @default(uuid())
  salonId    String
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String
  actorId    String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ───────────── Fidélité ─────────────

model LoyaltyProgram {
  salonId         String  @id
  enabled         Boolean @default(false)
  pointsPerVisit  Int     @default(10)
  pointsPer10Mad  Int     @default(0)
  salon           Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

enum RewardType {
  DISCOUNT_AMOUNT
  DISCOUNT_PERCENT
  FREE_SERVICE
}

model LoyaltyReward {
  id          String     @id @default(uuid())
  salonId     String
  name        String
  description String?
  pointsCost  Int
  type        RewardType
  value       Int?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  salon       Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  redemptions LoyaltyRedemption[]

  @@index([salonId])
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  salonId   String
  clientId  String
  points    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@unique([refType, refId, reason])
  @@index([salonId, clientId])
  @@index([clientId])
}

enum RedemptionStatus {
  PENDING
  USED
  CANCELLED
}

model LoyaltyRedemption {
  id        String           @id @default(uuid())
  salonId   String
  clientId  String
  rewardId  String
  code      String           @unique
  status    RedemptionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  usedAt    DateTime?
  reward    LoyaltyReward    @relation(fields: [rewardId], references: [id])

  @@index([salonId])
  @@index([clientId])
}

// ───────────── Avis ─────────────

model Review {
  id            String       @id @default(uuid())
  salonId       String
  clientId      String
  appointmentId String?      @unique
  ticketId      String?      @unique
  rating        Int
  comment       String?
  reply         String?
  repliedAt     DateTime?
  hidden        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  ticket        QueueTicket? @relation(fields: [ticketId], references: [id])

  @@index([salonId, hidden])
}

// ───────────── Notifications ─────────────

enum NotifChannel {
  PUSH
  EMAIL
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id        String       @id @default(uuid())
  userId    String
  channel   NotifChannel
  type      String
  title     String
  body      String
  data      Json?
  status    NotifStatus  @default(PENDING)
  error     String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  sentAt    DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Surcharge d'un modèle de message par défaut (modifiable par le Super Admin).
model NotificationTemplate {
  id      String @id @default(uuid())
  key     String
  locale  String
  title   String
  body    String

  @@unique([key, locale])
}

// ───────────── Abonnements ─────────────

model Plan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String   @default("")
  priceMad     Int
  durationDays Int      @default(30)
  features     Json
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

model Subscription {
  id               String             @id @default(uuid())
  salonId          String
  planId           String
  status           SubscriptionStatus @default(PENDING)
  startsAt         DateTime?
  endsAt           DateTime?
  cancelledAt      DateTime?
  expiryNotifiedAt DateTime?
  createdAt        DateTime           @default(now())

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([salonId, status])
}

enum PaymentStatus {
  PENDING
  TO_VERIFY
  VALIDATED
  REJECTED
}

model Payment {
  id             String        @id @default(uuid())
  salonId        String
  subscriptionId String
  amountMad      Int
  reference      String?
  proofKey       String?
  status         PaymentStatus @default(PENDING)
  adminNote      String?
  reviewedById   String?
  reviewedAt     DateTime?
  receiptNumber  String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([status])
}

// ───────────── Administration ─────────────

model PlatformSetting {
  key   String @id
  value Json
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  salonId    String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([salonId])
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Complaint {
  id         String          @id @default(uuid())
  authorId   String
  salonId    String?
  subject    String
  message    String
  status     ComplaintStatus @default(OPEN)
  adminReply String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
}
